# Copy to .env and fill in. .env is gitignored; this file is not.

# --- runtime ---
NODE_ENV=development
PORT=3000

# --- database ---
# Native install on 5432, or 5433 for the docker-compose postgres.
DATABASE_URL="postgresql://postgres:123@localhost:5432/adwya_dev?schema=public"

# --- redis (docker compose up -d redis) ---
# REDIS_URL wins over the individual fields when set.
# Redis is optional: the app boots and serves without it, /readyz reports "degraded".
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_URL=redis://localhost:6379

# --- auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=14d
PASSWORD_RESET_EXPIRES_IN=15m

# --- payments ---
# Shared secret the gateway signs webhook payloads with.
PAYMENT_WEBHOOK_SECRET=change-me-webhook

# --- seeding (optional) ---
# Set both to have `npm run prisma:seed` create a platform admin.
# SEED_ADMIN_PHONE=01000000099
# SEED_ADMIN_PASSWORD=change-me

# --- docker compose overrides (optional) ---
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=123
# POSTGRES_DB=adwya_dev
# POSTGRES_PORT=5433
